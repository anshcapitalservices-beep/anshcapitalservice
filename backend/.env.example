# Copy to backend/.env for local development. In production set these as
# Vercel environment variables; never commit real values.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only)
CORS_ORIGINS=""
# Required for the /admin portal. Use long random values, e.g. `openssl rand -base64 32`.
ADMIN_PASSWORD=""
ADMIN_TOKEN=""
# Optional: admin session length in seconds (default 8 hours)
# ADMIN_TOKEN_TTL_SECONDS="28800"
LEAD_NOTIFICATION_EMAIL="support@anshcapitalservices.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Firebase service account JSON (raw, quoted, or base64)
FIREBASE_SERVICE_ACCOUNT_JSON=""
